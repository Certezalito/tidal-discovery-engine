# Core API credentials
LASTFM_API_KEY=your_lastfm_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional Gemini model configuration
# Precedence for GEMINI_MODEL resolution: exported env var > .env value > built-in default (gemini-flash-latest)
# Leave blank or set to 'latest' to automatically use Google's latest Flash model
GEMINI_MODEL=

# Optional fallback model used only when primary model is unavailable/not found
GEMINI_FALLBACK_MODEL=

# Optional Gemini Flex tier configuration (50% cheaper token pricing, 1-15 min turnaround)
# GEMINI_SERVICE_TIER: 'flex' or 'standard' (default: standard)
GEMINI_SERVICE_TIER=
# GEMINI_FLEX_TIMEOUT_SECONDS: Client HTTP timeout in seconds for flex requests (default: 900)
GEMINI_FLEX_TIMEOUT_SECONDS=
# GEMINI_FLEX_MAX_RETRIES: Number of recovery retry attempts on capacity preemption (default: 5)
GEMINI_FLEX_MAX_RETRIES=
# GEMINI_FLEX_FALLBACK_STANDARD: true/false. If true, fall back to standard tier when flex is unavailable (default: false)
# GEMINI_SERVICE_TIER_FALLBACK: alias for GEMINI_FLEX_FALLBACK_STANDARD ('standard' or 'true' to enable)
GEMINI_FLEX_FALLBACK_STANDARD=
GEMINI_SERVICE_TIER_FALLBACK=
